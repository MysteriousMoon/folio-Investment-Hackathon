# Google Gemini native API: https://generativelanguage.googleapis.com/v1beta
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_FORMAT=google
# Full API base URL; blank/unset also uses the official default.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
FRED_API_KEY=
HOST=127.0.0.1
PORT=5050
# Set a random secret for deployment; use COOKIE_SECURE=1 with HTTPS.
SECRET_KEY=
COOKIE_SECURE=0
